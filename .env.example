# Copy to .env and edit. Never commit the real .env.

NODE_ENV=development
PORT=5000

# MongoDB. Local dev default shown; for a public launch use a hosted database
# (e.g. MongoDB Atlas) and paste its connection string here.
MONGODB_URI=mongodb://127.0.0.1:27017/health-report

# REQUIRED in production: at least 32 random characters. The server refuses to
# start in production without one. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development a fixed insecure fallback is used if this is unset.
JWT_SECRET=

# Browser origins allowed to call the API when the frontend is hosted on a
# different domain (comma-separated). Not needed in dev: Vite proxies /api.
# CORS_ORIGIN=https://your-app.example.com

# Optional, but recommended: identifies you to PubMed (NCBI) for the research feeds, and an API key
# raises the request limit. https://www.ncbi.nlm.nih.gov/account/settings/
# NCBI_EMAIL=you@example.com
# NCBI_API_KEY=

# AI features (optional). The FREE quick summary needs none of this: it is made by this server's own code, so it
# costs effectively nothing and sends nothing anywhere. The AI parts (a deeper look, and typed questions) need a
# key. Keep it server-side only. https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# The default is the cheap model: about 0.3-0.5 US cents per look or answer. claude-sonnet-5 and claude-opus-5
# reason better but cost several times more (Opus 5 with thinking is roughly 5 cents).
# AI_MODEL=claude-haiku-4-5
# Each member's rolling 30-day allowance of the paid AI features (the free summary is unlimited).
# AI_DEEP_PER_MONTH=2
# AI_QUESTIONS_PER_MONTH=5
# Development only: shows clearly-labelled DEMO results so the flow can be tried with no account.
# Refused in production. Never use this for real members.
# AI_MOCK=1

# Set to 1 (or the number of proxy hops) when running behind a load balancer or
# reverse proxy, so rate limiting sees real client IPs.
# TRUST_PROXY=1
