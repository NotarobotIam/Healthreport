{
  "name": "health-report-dashboard",
  "version": "1.0.0",
  "description": "A health report website with dashboard, authentication, and data analysis",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "web": "cd digital-twin && npm run dev",
    "build": "cd digital-twin && npm run build",
    "server": "node server.js",
    "both": "concurrently \"npm run server\" \"npm run web\"",
    "test": "node --test \"test/*.test.js\"",
    "seed:dev": "node scripts/seed-dev.js",
    "make-admin": "node scripts/make-admin.js"
  },
  "keywords": [
    "health",
    "report",
    "dashboard",
    "medical"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "concurrently": "^8.0.1",
    "nodemon": "^2.0.20"
  }
}
