{
  "name": "vital-dt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "4D anatomical digital twin \u2014 interactive anatomy explorer prototype",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:anatomy": "esbuild scripts/verifyAnatomy.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify-anatomy.cjs --log-level=error && node node_modules/.cache/verify-anatomy.cjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.99.0",
    "@react-three/fiber": "^8.15.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "three": "^0.160.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "camera-controls": "^2.9.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  }
}
